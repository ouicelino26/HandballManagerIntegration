<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="AdminTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style x:Key="AdminComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
        <Setter Property="MinHeight" Value="42"/>
    </Style>
</ResourceDictionary>
