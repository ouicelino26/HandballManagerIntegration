<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- TextBox: 8px padding, InputBorderBrush, FocusBrush focus ring -->
    <Style x:Key="AdminTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- ComboBox: same height as TextBox, consistent border -->
    <Style x:Key="AdminComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- DatePicker: consistent with TextBox/ComboBox -->
    <Style x:Key="AdminDatePickerStyle" TargetType="DatePicker">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- CheckBox: larger 24px hit target -->
    <Style x:Key="AdminCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="FontFamily" Value="{StaticResource AdminBodyFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- Label: aligns with LabelText style from Typography -->
    <Style x:Key="AdminLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource AdminBodyFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="Padding" Value="0,0,0,4"/>
    </Style>
</ResourceDictionary>
