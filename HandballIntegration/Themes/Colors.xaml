<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base surface tokens -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F1EFE8"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFDF8"/>
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#FFFFFF"/>
    <!-- Text tokens -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#17231F"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#52615B"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#78847F"/>
    <!-- Semantic tokens -->
    <SolidColorBrush x:Key="AccentBrush" Color="#D7633C"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#257352"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#A86416"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B5413D"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#2F6471"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D8D9D1"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#EA8A55"/>
    <!-- Admin shell (dark green sidebar) -->
    <SolidColorBrush x:Key="AdminShellBrush" Color="#17372E"/>
    <SolidColorBrush x:Key="AdminShellElevatedBrush" Color="#21483D"/>
    <SolidColorBrush x:Key="AdminShellTextBrush" Color="#FFF8ED"/>
    <!-- Navigation tokens -->
    <SolidColorBrush x:Key="NavItemActiveBrush" Color="#1E4D3F"/>
    <SolidColorBrush x:Key="NavItemHoverBrush" Color="#2A5A4A"/>
    <SolidColorBrush x:Key="NavItemTextBrush" Color="#E8F0ED"/>
    <SolidColorBrush x:Key="NavItemActiveTextBrush" Color="#FFFFFF"/>
    <!-- Badge tokens (aliases of semantic brushes) -->
    <SolidColorBrush x:Key="BadgeErrorBrush" Color="#B5413D"/>
    <SolidColorBrush x:Key="BadgeWarningBrush" Color="#A86416"/>
    <SolidColorBrush x:Key="BadgeSuccessBrush" Color="#257352"/>
    <!-- State tokens -->
    <SolidColorBrush x:Key="LoadingBrush" Color="#D8D9D1"/>
    <SolidColorBrush x:Key="PageHeaderBrush" Color="#17231F"/>
    <!-- Form input tokens -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="#C4C9C5"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#EA8A55"/>
    <!-- Button tokens -->
    <SolidColorBrush x:Key="ButtonPrimaryBrush" Color="#D7633C"/>
    <SolidColorBrush x:Key="ButtonPrimaryHoverBrush" Color="#C4552E"/>
    <SolidColorBrush x:Key="ButtonDestructiveBrush" Color="#B5413D"/>
    <SolidColorBrush x:Key="ButtonDestructiveHoverBrush" Color="#9B342F"/>
</ResourceDictionary>
