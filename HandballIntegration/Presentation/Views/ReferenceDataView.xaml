<UserControl x:Class="HandballIntegration.Presentation.Views.ReferenceDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:HandballIntegration.Components"
             xmlns:views="clr-namespace:HandballIntegration.Presentation.Views">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <components:AdminPageHeader Eyebrow="CATALOGUES METIER" Title="{Binding Title}" Subtitle="{Binding Subtitle}"/>
        <views:AdminStateView Grid.Row="2"/>
        <Border Grid.Row="4" Style="{StaticResource AdminCardStyle}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Six referentiels autorises" Style="{StaticResource SectionTitleStyle}"/>
                    <components:StatusBadge Grid.Column="1" Status="{Binding WriteAvailability.Status}"/>
                </Grid>
                <TabControl Grid.Row="2" Background="Transparent" BorderBrush="{StaticResource BorderBrush}">
                    <TabItem Header="Competitions"><DataGrid Margin="10" ItemsSource="{Binding Competitions}" Style="{StaticResource AdminDataGridStyle}" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Competition" Binding="{Binding CompetitionName}" Width="*"/><DataGridTextColumn Header="Code" Binding="{Binding CompetitionCode}" Width="180"/><DataGridTextColumn Header="Matchs" Binding="{Binding MatchCount}" Width="100"/></DataGrid.Columns></DataGrid></TabItem>
                    <TabItem Header="Evenements"><DataGrid Margin="10" ItemsSource="{Binding Events}" Style="{StaticResource AdminDataGridStyle}" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Libelle" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="180"/><DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="180"/></DataGrid.Columns></DataGrid></TabItem>
                    <TabItem Header="Postes"><DataGrid Margin="10" ItemsSource="{Binding Positions}" Style="{StaticResource AdminDataGridStyle}" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Poste" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="180"/></DataGrid.Columns></DataGrid></TabItem>
                    <TabItem Header="Nationalites"><DataGrid Margin="10" ItemsSource="{Binding Nationalities}" Style="{StaticResource AdminDataGridStyle}" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Nationalite" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="180"/></DataGrid.Columns></DataGrid></TabItem>
                    <TabItem Header="Attaques"><DataGrid Margin="10" ItemsSource="{Binding Attacks}" Style="{StaticResource AdminDataGridStyle}" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Attaque" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="180"/><DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="180"/></DataGrid.Columns></DataGrid></TabItem>
                    <TabItem Header="Defenses"><DataGrid Margin="10" ItemsSource="{Binding Defenses}" Style="{StaticResource AdminDataGridStyle}" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Defense" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="180"/><DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="180"/></DataGrid.Columns></DataGrid></TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
