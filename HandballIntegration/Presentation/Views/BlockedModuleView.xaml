<UserControl x:Class="HandballIntegration.Presentation.Views.BlockedModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:HandballIntegration.Components">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <components:AdminPageHeader Eyebrow="CONTRAT SERVEUR REQUIS" Title="{Binding Title}" Subtitle="{Binding Subtitle}"/>
            <Border Grid.Row="2" MaxWidth="760" HorizontalAlignment="Left" Style="{StaticResource AdminCardStyle}">
                <StackPanel>
                    <components:StatusBadge HorizontalAlignment="Left" Status="{Binding Availability.Status}"/>
                    <TextBlock Margin="0,18,0,0" Text="{Binding Availability.Message}" TextWrapping="Wrap"
                               Foreground="{StaticResource PrimaryTextBrush}" FontSize="15"/>
                    <Border Margin="0,18,0,0" Padding="14" CornerRadius="12" Background="{StaticResource SurfaceBrush}">
                        <StackPanel>
                            <TextBlock Text="Contrat attendu" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock Margin="0,5,0,0" Text="{Binding Availability.RequiredRoute}" TextWrapping="Wrap"
                                       FontFamily="Consolas" Foreground="{StaticResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="0,18,0,0" Text="Aucune donnee fictive et aucune action de contournement ne sont proposees."
                               TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
