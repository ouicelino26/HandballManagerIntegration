<UserControl x:Class="HandballIntegration.Presentation.Views.UsersAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:HandballIntegration.Components"
             xmlns:views="clr-namespace:HandballIntegration.Presentation.Views"
             xmlns:behaviors="clr-namespace:HandballIntegration.Presentation.Behaviors">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <components:AdminPageHeader Eyebrow="ACCES ET ROLES" Title="{Binding Title}" Subtitle="{Binding Subtitle}"/>
        <views:AdminStateView Grid.Row="2"/>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource AdminCardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Comptes" Style="{StaticResource SectionTitleStyle}"/>
                        <Button Grid.Column="1" Content="Nouveau compte" Command="{Binding NewUserCommand}"/>
                    </Grid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                              Style="{StaticResource AdminDataGridStyle}" EnableRowVirtualization="True"
                              AutomationProperties.Name="Liste des comptes">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Identifiant" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120"/>
                            <DataGridCheckBoxColumn Header="Actif" Binding="{Binding IsActive, Mode=OneWay}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource AdminCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Edition du compte" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Selectionnez un compte ou creez-en un nouveau. Aucun mot de passe ni hash n'est relu par l'application."
                                   Margin="0,4,0,14" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <StackPanel Visibility="{Binding IsEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Identifiant" Style="{StaticResource EyebrowTextStyle}"/>
                            <TextBox Margin="0,6,0,12" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource AdminTextBoxStyle}" AutomationProperties.Name="Identifiant du compte"/>
                            <TextBlock Text="Email" Style="{StaticResource EyebrowTextStyle}"/>
                            <TextBox Margin="0,6,0,12" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource AdminTextBoxStyle}" AutomationProperties.Name="Adresse email"/>
                            <TextBlock Text="Mot de passe" Style="{StaticResource EyebrowTextStyle}"/>
                            <PasswordBox Margin="0,6,0,4" Style="{StaticResource AppPasswordBoxStyle}"
                                         behaviors:PasswordBoxBinding.IsEnabled="True"
                                         behaviors:PasswordBoxBinding.BoundPassword="{Binding Password, Mode=TwoWay}"
                                         AutomationProperties.Name="Mot de passe du compte"/>
                            <TextBlock Text="8 caracteres minimum, avec une lettre et un chiffre pour une creation."
                                       Margin="0,0,0,12" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap"/>
                            <TextBlock Text="Role" Style="{StaticResource EyebrowTextStyle}"/>
                            <ComboBox Margin="0,6,0,12" ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"
                                      Style="{StaticResource AdminComboBoxStyle}" AutomationProperties.Name="Role du compte"/>
                            <CheckBox Content="Compte actif" IsChecked="{Binding IsActive}" Margin="0,0,0,16"/>
                            <WrapPanel HorizontalAlignment="Right">
                                <Button Content="Annuler" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
                                <Button Content="Enregistrer" Command="{Binding SaveUserCommand}" Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
