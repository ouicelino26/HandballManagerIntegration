<UserControl x:Class="HandballIntegration.Presentation.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:HandballIntegration.Components"
             xmlns:views="clr-namespace:HandballIntegration.Presentation.Views">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <components:AdminPageHeader Eyebrow="TRACABILITE" Title="{Binding Title}" Subtitle="{Binding Subtitle}"/>
        <views:AdminStateView Grid.Row="2"/>
        <Border Grid.Row="4" Style="{StaticResource AdminCardStyle}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <WrapPanel>
                        <TextBox Width="190" Margin="0,0,8,0" Tag="Type d'entite" Text="{Binding EntityType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AdminTextBoxStyle}"/>
                        <TextBox Width="210" Margin="0,0,8,0" Tag="Reference metier" Text="{Binding EntityReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AdminTextBoxStyle}"/>
                        <ComboBox Width="90" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Style="{StaticResource AdminComboBoxStyle}"/>
                    </WrapPanel>
                    <Button Grid.Column="1" Content="Rechercher" Command="{Binding ApplyFiltersCommand}"/>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" Style="{StaticResource AdminDataGridStyle}"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Journal d'audit">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date UTC" Binding="{Binding TimestampUtc, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="145"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="130"/>
                            <DataGridTextColumn Header="Entite" Binding="{Binding EntityType}" Width="120"/>
                            <DataGridTextColumn Header="Utilisateur" Binding="{Binding UserId}" Width="120"/>
                            <DataGridCheckBoxColumn Header="Succes" Binding="{Binding Success}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Column="2" Padding="14" CornerRadius="12" Background="{StaticResource SoftNeutralBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Diff avant / apres" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Selectionnez une trace pour consulter les donnees redigees."
                                           Margin="0,4,0,12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="AVANT" Style="{StaticResource EyebrowTextStyle}"/>
                                <TextBox Margin="0,6,0,12" Text="{Binding SelectedEntry.BeforeJson}" IsReadOnly="True" AcceptsReturn="True"
                                         MinHeight="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource AdminTextBoxStyle}"/>
                                <TextBlock Text="APRES" Style="{StaticResource EyebrowTextStyle}"/>
                                <TextBox Margin="0,6,0,12" Text="{Binding SelectedEntry.AfterJson}" IsReadOnly="True" AcceptsReturn="True"
                                         MinHeight="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource AdminTextBoxStyle}"/>
                                <TextBlock Text="{Binding SelectedEntry.Reason, StringFormat=Motif : {0}}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Total, StringFormat={}{0} trace(s)}" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Precedente" Command="{Binding PreviousPageCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Suivante" Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
