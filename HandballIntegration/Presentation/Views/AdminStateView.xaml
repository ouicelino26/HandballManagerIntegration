<UserControl x:Class="HandballIntegration.Presentation.Views.AdminStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:HandballIntegration.Components"
             IsTabStop="False">
    <Border Padding="12,9" CornerRadius="12" Background="{StaticResource SoftNeutralBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <components:StatusBadge Status="{Binding State.Kind}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding State.Title}" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="{Binding State.Message}" Margin="0,2,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
            </StackPanel>
            <Button Grid.Column="3" Content="Actualiser" Margin="12,0,0,0" MinWidth="88"
                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}"
                    AutomationProperties.Name="Actualiser le module"/>
        </Grid>
    </Border>
</UserControl>
