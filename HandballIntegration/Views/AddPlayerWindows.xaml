<Window x:Class="HandballIntegration.Views.AddPlayerWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Creer une joueuse"
        Height="660"
        Width="460"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <DataTemplate x:Key="TeamItemTemplate">
            <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}"/>
        </DataTemplate>

        <DataTemplate x:Key="LookupItemTemplate">
            <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}"/>
        </DataTemplate>

        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border Style="{StaticResource HeroCardStyle}" Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="Creation assistee"/>
                    <TextBlock Margin="0,8,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Text="Creer une nouvelle joueuse"/>
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="Complete les informations minimales pour poursuivre l'integration sans casser le flux en cours."/>
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Identite" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Prenom *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="FirstNameTextBox" Style="{StaticResource AppTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Nom *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="LastNameTextBox" Style="{StaticResource AppTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Date de naissance" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker x:Name="BirthDatePicker" Style="{StaticResource AppDatePickerStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Numero" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="NumberTextBox"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             PreviewTextInput="NumberOnly"
                                             ToolTip="Uniquement des chiffres"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Affectation" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Equipe *" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="TeamComboBox"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                              ItemTemplate="{StaticResource TeamItemTemplate}"
                                              SelectedValuePath="Id"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Poste *" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="PositionComboBox"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                              ItemTemplate="{StaticResource LookupItemTemplate}"
                                              SelectedValuePath="Id"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Nationalite *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="NationalityComboBox"
                                          Style="{StaticResource AppComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                          ItemTemplate="{StaticResource LookupItemTemplate}"
                                          SelectedValuePath="Id"/>
                            </StackPanel>

                            <CheckBox x:Name="IsActiveCheckBox"
                                      Margin="0,0,0,8"
                                      IsChecked="True"
                                      Content="Joueuse active"
                                      Foreground="{StaticResource PrimaryTextBrush}"/>

                            <TextBlock Text="* Champs obligatoires"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Annuler"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Cancel_Click"
                            IsCancel="True"/>

                    <Button Content="Creer"
                            Click="Validate_Click"
                            IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
