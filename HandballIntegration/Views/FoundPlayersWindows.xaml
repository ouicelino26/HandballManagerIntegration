<Window x:Class="HandballIntegration.Views.FoundPlayersWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selection d'une joueuse"
        Height="500"
        Width="500"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="ListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="PlayerBorder"
                                Background="{StaticResource ElevatedSurfaceBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="14">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PlayerBorder" Property="Background" Value="#FFF5ED"/>
                                <Setter TargetName="PlayerBorder" Property="BorderBrush" Value="#E8C1AE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PlayerBorder" Property="Background" Value="{StaticResource AccentAltSoftBrush}"/>
                                <Setter TargetName="PlayerBorder" Property="BorderBrush" Value="{StaticResource AccentAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border Style="{StaticResource HeroCardStyle}" Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="Rapprochement joueuse"/>
                    <TextBlock Margin="0,8,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Text="Selectionner la meilleure correspondance"/>
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="{Binding SearchText, StringFormat=Recherche initiale : {0}}"/>
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="{Binding Players.Count, StringFormat=Resultats proposes : {0}}"/>
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Padding="16">
                    <ListBox x:Name="PlayersListBox"
                             ItemsSource="{Binding Players}"
                             Foreground="Black"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemContainerStyle="{StaticResource ListItemStyle}"
                             MouseDoubleClick="PlayersListBox_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding FullName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="{Binding TeamName, FallbackValue=Equipe inconnue}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <Border Padding="10,6"
                                                CornerRadius="12"
                                                Background="{StaticResource SoftNeutralBrush}">
                                            <TextBlock Text="{Binding Number, StringFormat=N° {0}}"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Margin="0,6,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="{Binding IsActive, StringFormat=Active : {0}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Annuler"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsCancel="True"
                            Click="Cancel_Click"/>
                    <Button Content="Valider"
                            IsDefault="True"
                            Click="Validate_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
