<Page x:Class="HandballIntegration.Views.SendPdf"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HandballIntegration.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SendPdf">

    <Grid Background="#F2F2F2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANNEAU OUTILS -->
        <StackPanel Grid.Column="0" Background="#1F2933" Margin="10">
            <TextBlock Text="Outils" Foreground="White" FontSize="18" Margin="0,0,0,10"/>

            <Button Content="➕ Texte" Margin="0,5" Click="AddText_Click"/>
            <Button Content="➕ Tableau stats" Margin="0,5" Click="AddTable_Click"/>
            <Button Content="📄 Export PDF" Margin="0,20" Click="ExportPdf_Click"/>
        </StackPanel>

        <!-- ZONE PAGE -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid HorizontalAlignment="Center" Margin="20">

                <!-- Ombre -->
                <Border Width="820" Height="1160" Background="#DDD" CornerRadius="6"/>

                <!-- PAGE A4 -->
                <Canvas x:Name="EditorCanvas"
                    Width="794"
                    Height="1123"
                    Background="White"/>

            </Grid>
        </ScrollViewer>
    </Grid>

</Page>
