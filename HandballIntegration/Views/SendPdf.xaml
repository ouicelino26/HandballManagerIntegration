<Page x:Class="HandballIntegration.Views.SendPdf"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="SendPdf">

    <Page.Resources>
        <Style x:Key="ComposerButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Studio PDF"/>
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="Composer rapidement la page puis exporter."/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Exporter le PDF"
                        Width="152"
                        Click="ExportPdf_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="Outils"/>

                    <Button Grid.Row="2"
                            Style="{StaticResource ComposerButtonStyle}"
                            Click="AddText_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="10"
                                    Background="#FFFFFFFF">
                                <TextBlock Text="T"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Foreground="{StaticResource AccentAltDarkBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="Ajouter un bloc texte"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentAltDarkBrush}"/>
                        </Grid>
                    </Button>

                    <Button Grid.Row="4"
                            Style="{StaticResource ComposerButtonStyle}"
                            Click="AddTable_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="10"
                                    Background="#FFFFFFFF">
                                <TextBlock Text="G"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Foreground="{StaticResource AccentAltDarkBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="Ajouter une grille"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentAltDarkBrush}"/>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="Canevas"/>

                    <Border Grid.Row="2"
                            CornerRadius="22"
                            Background="#F0E6DA"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            Padding="20">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid HorizontalAlignment="Center">
                                <Border Width="794"
                                        Height="1123"
                                        Background="White"
                                        BorderBrush="#E7DED2"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Effect="{StaticResource SoftPanelShadow}">
                                    <Canvas x:Name="EditorCanvas"
                                            Width="794"
                                            Height="1123"
                                            Background="White"/>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
