<Page x:Class="HandballIntegration.Views.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Comptes utilisateurs"/>
                    <TextBlock x:Name="UsersHintText"
                               Margin="0,8,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="Creer rapidement un compte Admin ou Consultation."/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="RefreshUsersButton"
                        Content="Actualiser"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RefreshUsers_Click"/>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="3">
            <Border Margin="0,0,8,0" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="Total comptes"/>
                    <TextBlock x:Name="UsersCountText"
                               Margin="0,6,0,0"
                               Style="{StaticResource MetricValueTextStyle}"
                               Text="0"/>
                </StackPanel>
            </Border>

            <Border Margin="8,0" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="Admins"/>
                    <TextBlock x:Name="AdminsCountText"
                               Margin="0,6,0,0"
                               Style="{StaticResource MetricValueTextStyle}"
                               Text="0"/>
                </StackPanel>
            </Border>

            <Border Margin="8,0,0,0" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="Consultation"/>
                    <TextBlock x:Name="ConsultationCountText"
                               Margin="0,6,0,0"
                               Style="{StaticResource MetricValueTextStyle}"
                               Text="0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="Creer un compte"/>
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource BodyTextStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Margin="0,0,0,6"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Nom d'utilisateur"/>
                        <TextBox x:Name="UsernameTextBox"
                                 Style="{StaticResource AppTextBoxStyle}"
                                 Tag="Ex. admin.metier"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <TextBlock Margin="0,0,0,6"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Email"/>
                        <TextBox x:Name="EmailTextBox"
                                 Style="{StaticResource AppTextBoxStyle}"
                                 Tag="Optionnel"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6">
                        <TextBlock Margin="0,0,0,6"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Role"/>
                        <ComboBox x:Name="RoleComboBox"
                                  Foreground="Black"
                                  Style="{StaticResource AppComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="8">
                        <TextBlock Margin="0,0,0,6"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Mot de passe"/>
                        <PasswordBox x:Name="PasswordInput"
                                     Style="{StaticResource AppPasswordBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="10">
                        <TextBlock Margin="0,0,0,6"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Confirmation"/>
                        <PasswordBox x:Name="ConfirmPasswordInput"
                                     Style="{StaticResource AppPasswordBoxStyle}"/>
                    </StackPanel>

                    <Border Grid.Row="12"
                            x:Name="FormMessageBorder"
                            Background="{StaticResource AccentAltSoftBrush}"
                            CornerRadius="14"
                            Padding="12,10"
                            Visibility="Collapsed">
                        <TextBlock x:Name="FormMessageText"
                                   Foreground="{StaticResource AccentAltDarkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Button Grid.Row="14"
                            x:Name="CreateUserButton"
                            Content="Creer le compte"
                            HorizontalAlignment="Right"
                            Click="CreateUser_Click"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="Comptes existants"/>
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource BodyTextStyle}"
                                   Text="Vue rapide des utilisateurs actuellement exposes par l'API."/>
                    </StackPanel>

                    <DataGrid Grid.Row="2"
                              x:Name="UsersGrid"
                              Style="{StaticResource AppDataGridStyle}"
                              IsReadOnly="True"
                              CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Utilisateur" Binding="{Binding Username}" Width="1.4*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding EmailDisplay}" Width="1.8*"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="1*"/>
                            <DataGridTextColumn Header="Statut" Binding="{Binding StatusLabel}" Width="1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
