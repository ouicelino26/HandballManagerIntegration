<Window x:Class="HandballIntegration.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Connexion"
        Width="920"
        Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="18">
        <Border Style="{StaticResource SurfaceCardStyle}"
                Padding="0"
                CornerRadius="28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource ShellGradientBrush}"
                        CornerRadius="28,0,0,28"
                        Padding="32">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border Width="118"
                                    Padding="10,6"
                                    CornerRadius="12"
                                    Background="#18FFFFFF"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="Admin access"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="#FFF9F2"/>
                            </Border>

                            <TextBlock Margin="0,18,0,0"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="#FFF9F2"
                                       Text="Handball Integration"/>

                            <TextBlock Margin="0,10,0,0"
                                       FontSize="14"
                                       Foreground="#D9E8E2"
                                       TextWrapping="Wrap"
                                       />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center">
                            <Border Margin="0,0,0,12"
                                    Padding="16,14"
                                    Background="#18FFFFFF"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="18">
                               
                            </Border>

                            <Border Padding="16,14"
                                    Background="#16FFFFFF"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                <StackPanel>
                                    <TextBlock Text="Session securisee"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#FFF9F2"/>
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Text="L'adresse technique est geree dans les parametres de l'application."
                                               Foreground="#D9E8E2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </Border>

                <Grid Grid.Column="1"
                      Margin="36">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="Connexion"/>
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Text="Ouvrir une session admin"/>
                      
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Margin="0,0,0,6"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Nom d'utilisateur"/>
                        <TextBox x:Name="UsernameTextBox"
                                 Style="{StaticResource AppTextBoxStyle}"
                                 Tag="Ex. admin"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <TextBlock Margin="0,0,0,6"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Mot de passe"/>
                        <PasswordBox x:Name="PasswordInput"
                                     Style="{StaticResource AppPasswordBoxStyle}"/>
                    </StackPanel>

                    <Border Grid.Row="6"
                            x:Name="ErrorContainer"
                            Background="{StaticResource DangerSoftBrush}"
                            CornerRadius="14"
                            Padding="12,10"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Grid.Row="8"
                               x:Name="BusyText"
                               Style="{StaticResource BodyTextStyle}"
                               Visibility="Collapsed"
                               Text="Verification en cours..."/>

                    <StackPanel Grid.Row="10"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Quitter"
                                Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Cancel_Click"
                                IsCancel="True"/>
                        <Button x:Name="LoginButton"
                                Content="Se connecter"
                                Click="Login_Click"
                                IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
