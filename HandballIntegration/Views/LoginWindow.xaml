<Window x:Class="HandballIntegration.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:behaviors="clr-namespace:HandballIntegration.Presentation.Behaviors"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Connexion HandWStat" Width="920" Height="560" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow">
    <Grid Margin="18">
        <Border Style="{StaticResource SurfaceCardStyle}" Padding="0" CornerRadius="28">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource ShellGradientBrush}" CornerRadius="28,0,0,28" Padding="32">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <Border Padding="10,6" CornerRadius="12" Background="#18FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" HorizontalAlignment="Left">
                                <TextBlock Text="HANDWSTAT ADMIN" FontSize="10" FontWeight="SemiBold" Foreground="#FFF9F2"/>
                            </Border>
                            <TextBlock Margin="0,22,0,0" FontFamily="{StaticResource AdminDisplayFont}" FontSize="34" FontWeight="SemiBold" Foreground="#FFF9F2" Text="Pilotez la qualite.&#x0a;Gardez la trace."/>
                            <TextBlock Margin="0,14,0,0" MaxWidth="340" FontSize="13" Foreground="#D9E8E2" TextWrapping="Wrap"
                                       Text="Imports controles, correction des matchs et administration des referentiels dans un espace securise."/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <Border Padding="16,14" Background="#18FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="18">
                                <StackPanel>
                                    <TextBlock Text="Session protegee" FontSize="15" FontWeight="SemiBold" Foreground="#FFF9F2"/>
                                    <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="#D9E8E2"
                                               Text="Les droits sont charges depuis l'API apres connexion. Le jeton reste uniquement en memoire."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#72D6A8" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Environment}" Margin="8,0,0,0" Foreground="#D9E8E2" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="36">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="CONNEXION"/>
                        <TextBlock Margin="0,8,0,0" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Ouvrir votre session"/>
                        <TextBlock Margin="0,6,0,0" Text="Utilisez votre compte d'administration HandWStat." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="Identifiant"/>
                        <TextBox x:Name="UsernameTextBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsFormEnabled}"
                                 Style="{StaticResource AppTextBoxStyle}" Tag="Ex. operateur" AutomationProperties.Name="Identifiant"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4">
                        <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="Mot de passe"/>
                        <PasswordBox IsEnabled="{Binding IsFormEnabled}" Style="{StaticResource AppPasswordBoxStyle}"
                                     behaviors:PasswordBoxBinding.IsEnabled="True"
                                     behaviors:PasswordBoxBinding.BoundPassword="{Binding Password, Mode=TwoWay}"
                                     AutomationProperties.Name="Mot de passe"/>
                    </StackPanel>
                    <Border Grid.Row="6" Background="{StaticResource DangerSoftBrush}" CornerRadius="14" Padding="12,10"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Grid.Row="8" Style="{StaticResource BodyTextStyle}" Text="Verification securisee en cours..."
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Quitter" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" IsCancel="True"/>
                        <Button Content="Se connecter" Command="{Binding LoginCommand}" IsDefault="True" AutomationProperties.Name="Se connecter"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
