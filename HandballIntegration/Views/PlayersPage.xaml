<Page x:Class="HandballIntegration.Views.PlayersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019">

    <Page.Resources>
        <Style x:Key="InlineEditButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="InlineDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DialogLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <ui:ContentDialog x:Key="EditPlayerDialog"
                          Title="Modifier la joueuse"
                          PrimaryButtonText="Enregistrer"
                          CloseButtonText="Fermer"
                          DefaultButton="Primary"
                          Width="620">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Edition locale en attendant la route de mise a jour API."/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                        <TextBlock Text="Nom complet" Style="{StaticResource DialogLabelStyle}"/>
                        <TextBox Text="{Binding FullName}" Style="{StaticResource AppTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12">
                        <TextBlock Text="Age" Style="{StaticResource DialogLabelStyle}"/>
                        <TextBox Text="{Binding Age}" Style="{StaticResource AppTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                        <TextBlock Text="Equipe" Style="{StaticResource DialogLabelStyle}"/>
                        <TextBox Text="{Binding TeamName}" Style="{StaticResource AppTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12">
                        <TextBlock Text="Poste" Style="{StaticResource DialogLabelStyle}"/>
                        <TextBox Text="{Binding PositionName}" Style="{StaticResource AppTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                        <TextBlock Text="Nationalite" Style="{StaticResource DialogLabelStyle}"/>
                        <TextBox Text="{Binding CountryName}" Style="{StaticResource AppTextBoxStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ui:ContentDialog>
    </Page.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Joueuses"/>
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="Recherche rapide et actions directes."/>
                    <TextBox x:Name="SearchBox"
                             Margin="0,14,0,0"
                             Width="360"
                             Style="{StaticResource WatermarkTextBox}"
                             Tag="Rechercher une joueuse, une equipe, un poste"
                             TextChanged="SearchBox_TextChanged"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="14,10"
                        CornerRadius="16"
                        Background="{StaticResource AccentAltSoftBrush}"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="ResultsSummaryText"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentAltDarkBrush}"
                               Text="Chargement"/>
                </Border>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="3">
            <Border Margin="0,0,8,0" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="Profils"/>
                    <TextBlock x:Name="PlayersCountText"
                               Margin="0,6,0,0"
                               Style="{StaticResource MetricValueTextStyle}"
                               Text="--"/>
                </StackPanel>
            </Border>

            <Border Margin="8,0" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="Resultats"/>
                    <TextBlock x:Name="ResultsCountText"
                               Margin="0,6,0,0"
                               Style="{StaticResource MetricValueTextStyle}"
                               Text="--"/>
                </StackPanel>
            </Border>

            <Border Margin="8,0,0,0" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="Equipes"/>
                    <TextBlock x:Name="TeamsCountText"
                               Margin="0,6,0,0"
                               Style="{StaticResource MetricValueTextStyle}"
                               Text="--"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="4" Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Liste"/>
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="Edition et suppression directement dans le tableau."/>
                </StackPanel>

                <DataGrid Grid.Row="2"
                          x:Name="PlayersGrid"
                          Style="{StaticResource AppDataGridStyle}"
                          IsReadOnly="True"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom complet"
                                            Binding="{Binding FullName}"
                                            SortMemberPath="FullName"
                                            Width="2.2*"/>
                        <DataGridTextColumn Header="Age"
                                            Binding="{Binding Age}"
                                            SortMemberPath="Age"
                                            Width="0.7*"/>
                        <DataGridTextColumn Header="Equipe"
                                            Binding="{Binding TeamName}"
                                            SortMemberPath="TeamName"
                                            Width="1.5*"/>
                        <DataGridTextColumn Header="Poste"
                                            Binding="{Binding PositionName}"
                                            SortMemberPath="PositionName"
                                            Width="1.2*"/>
                        <DataGridTextColumn Header="Pays"
                                            Binding="{Binding CountryName}"
                                            SortMemberPath="CountryName"
                                            Width="1.2*"/>
                        <DataGridTemplateColumn Header="Actions" Width="1.6*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Editer"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource InlineEditButtonStyle}"
                                                Click="EditPlayer_Click"/>
                                        <Button Content="Supprimer"
                                                Style="{StaticResource InlineDeleteButtonStyle}"
                                                Click="DeletePlayer_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
