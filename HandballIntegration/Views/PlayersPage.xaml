<Page x:Class="HandballIntegration.Views.PlayersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TITRE -->
        <TextBlock Text="Liste des joueuses"
                   FontSize="32"
                   FontWeight="Bold"
                   Margin="0 0 0 10"
                   Foreground="#222"/>

        <!-- BARRE DE RECHERCHE -->
        <DockPanel Grid.Row="1" Margin="0 0 0 15">
            <TextBox Style="{StaticResource WatermarkTextBox}"
          Tag="Rechercher..."
          x:Name="SearchBox"
          Width="300"
          Height="32"
          TextChanged="SearchBox_TextChanged"/>



            <Button Content="🔍"
                    Width="40" Height="38"
                    ui:ControlHelper.CornerRadius="8"
                    Background="#3D7DFF"
                    Foreground="White"/>
        </DockPanel>

        <!-- TABLEAU -->
        <DataGrid x:Name="PlayersGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  RowHeight="40"
                  ColumnHeaderHeight="45"
                  BorderThickness="0"
                  AlternatingRowBackground="#F6F6F6"
                  RowBackground="White"
                  FontSize="14"
                  GridLinesVisibility="None"
                  ui:ControlHelper.CornerRadius="8"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <!-- EN-TÊTES MODERNES -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Background" Value="#ECECEC"/>
                    <Setter Property="Foreground" Value="#333"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#D0D0D0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <!-- CELLULES -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="10 0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="#333"/>
                    <Setter Property="FontSize" Value="14"/>
                </Style>
            </DataGrid.CellStyle>

            <!-- COLONNES -->
            <DataGrid.Columns>

                <DataGridTextColumn Header="Nom complet"
                                    Binding="{Binding FullName}"
                                    SortMemberPath="FullName"
                                    Width="*"/>

                <DataGridTextColumn Header="Âge"
                                    Binding="{Binding Age}"
                                    SortMemberPath="Age"
                                    Width="80"/>

                <DataGridTextColumn Header="Équipe"
                                    Binding="{Binding TeamName}"
                                    SortMemberPath="TeamName"
                                    Width="150"/>

                <DataGridTextColumn Header="Poste"
                                    Binding="{Binding PositionName}"
                                    SortMemberPath="PositionName"
                                    Width="150"/>

                <DataGridTextColumn Header="Pays"
                                    Binding="{Binding CountryName}"
                                    SortMemberPath="CountryName"
                                    Width="150"/>

                <!-- ACTIONS -->
                <DataGridTemplateColumn Header="Actions" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <Button Width="35" Height="30"
                                        Margin="0 0 8 0"
                                        Background="#FFC107"
                                        ui:ControlHelper.CornerRadius="6"
                                        Click="EditPlayer_Click">
                                    <TextBlock Text="✏️"/>
                                </Button>

                                <Button Width="35" Height="30"
                                        Background="#D32F2F"
                                        Foreground="White"
                                        ui:ControlHelper.CornerRadius="6"
                                        Click="DeletePlayer_Click">
                                    <TextBlock Text="🗑️"/>
                                </Button>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>

</Page>
