<Page x:Class="HandballIntegration.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Dernières données enregistrées"
                   FontSize="28"
                   Margin="0 0 0 20"/>

        <DataGrid Grid.Row="1"
                  x:Name="RecentDataGrid"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"/>
    </Grid>

</Page>
