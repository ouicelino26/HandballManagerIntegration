    <Page x:Class="HandballIntegration.Views.IntegrationPage"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:ui="http://schemas.modernwpf.com/2019"
          xmlns:conv="clr-namespace:HandballIntegration.Converters"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          mc:Ignorable="d">

  
        <Page.Resources>
            <conv:StatusToBusyVisibilityConverter x:Key="BusyVisibility"/>
            <conv:StatusToSuccessVisibilityConverter x:Key="SuccessVisibility"/>
            <conv:StatusToErrorVisibilityConverter x:Key="ErrorVisibility"/>
            <conv:StatusToPendingVisibilityConverter x:Key="PendingVisibility"/>
        </Page.Resources>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <TextBlock Text="Intégration des données"
                       FontSize="28"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 20"/>

            <!-- Sélection du dossier -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 15">
                <Button Content="Choisir un dossier"
                        Width="150"
                        Click="BrowseFolder_Click"/>

                <TextBlock Text="{Binding SelectedFolder}"
                           VerticalAlignment="Center"
                           Margin="10 0"/>
            </StackPanel>

            <!-- DataGrid scrollable -->
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Files}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      RowHeight="40"
                      BorderThickness="0"
                      GridLinesVisibility="None"
                      Background="White"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">

                <!-- EN-TÊTES MODERNES -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Background" Value="#ECECEC"/>
                        <Setter Property="Foreground" Value="#333"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#D0D0D0"/>
                        <Setter Property="Padding" Value="8"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- CELLULES -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10 0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="#333"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.CellStyle>

                <!-- COLONNES -->
                <DataGrid.Columns>

                    <!-- Nom du fichier -->
                    <DataGridTextColumn Header="Fichier"
                                        Binding="{Binding FileName}"
                                        Width="2*"/>

                    <!-- Chemin complet -->
                    <DataGridTextColumn Header="Chemin"
                                        Binding="{Binding FullPath}"
                                        Width="3*"/>

                    <!-- Date du match -->
                    <DataGridTemplateColumn Header="Date du match" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding MatchInfo.Date, Mode=TwoWay}"
                                            HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- BOUTON INTÉGRER -->
                    <DataGridTemplateColumn Header="Action" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <Button Content="Intégrer"
                                            Width="80"
                                            Height="30"
                                            Background="#3D7DFF"
                                            Click="Integration_Click"
                                            Foreground="White"
                                            Command="{Binding DataContext.IntegrateCommand,
                                                              RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="6">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COLONNE STATUT -->
                    <DataGridTemplateColumn Header="Statut" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>

                                    <!-- 🔄 EN COURS -->
                                    <StackPanel Orientation="Horizontal"
                Visibility="{Binding Status, Converter={StaticResource BusyVisibility}}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="8">

                                        <ui:ProgressRing Width="22" Height="22" IsActive="True"/>

                                        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="#555"
                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- ✔ OK -->
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding Status, Converter={StaticResource SuccessVisibility}}">
                                        <TextBlock Text="✔"
                                                   Foreground="Green"
                                                   FontSize="18"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding StatusMessage}"
                                                   Foreground="Green"/>
                                    </StackPanel>

                                    <!-- ❌ ERREUR -->
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding Status, Converter={StaticResource ErrorVisibility}}">
                                        <TextBlock Text="❌"
                                                   Foreground="Red"
                                                   FontSize="18"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding StatusMessage}"
                                                   Foreground="Red"/>
                                    </StackPanel>

                                    <!-- ⏳ EN ATTENTE -->
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding Status, Converter={StaticResource PendingVisibility}}">
                                        <TextBlock Text="⏳"
                                                   FontSize="18"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="En attente"
                                                   Foreground="#777"/>
                                    </StackPanel>

                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>
    </Page>
