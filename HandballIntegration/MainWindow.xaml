<Window x:Class="HandballIntegration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="HandWStat Administration"
        Width="1440" Height="900" MinWidth="980" MinHeight="700"
        Background="{StaticResource AppBackgroundBrush}">
    <Window.Resources>
        <DataTemplate x:Key="NavigationTemplate">
            <Grid Height="50" ToolTip="{Binding Label}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="10" Background="#18FFFFFF" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Glyph}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                    <TextBlock Text="{Binding Description}" Margin="0,2,0,0" FontSize="9" Opacity="0.64" TextTrimming="CharacterEllipsis"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="10" Padding="14" Background="{StaticResource AdminShellBrush}" CornerRadius="24">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="264"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                            <Setter Property="Width" Value="72"/>
                            <Setter Property="Padding" Value="10"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="13" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="HW" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding ApplicationName}" Foreground="{StaticResource AdminShellTextBrush}" FontFamily="{StaticResource AdminDisplayFont}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Centre d'administration" Foreground="#BFD0C9" FontSize="9"/>
                    </StackPanel>
                    <Button Grid.Column="2" Width="34" Height="34" MinWidth="34" Padding="0" Content="&#x2630;"
                            Background="#18FFFFFF" BorderBrush="#30FFFFFF" Command="{Binding ToggleSidebarCommand}"
                            AutomationProperties.Name="Replier ou deplier la navigation"/>
                </Grid>

                <TextBox Grid.Row="2" Tag="Rechercher un module" Text="{Binding GlobalSearch, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Recherche globale des modules">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource AdminTextBoxStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <ListBox Grid.Row="4" ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                         ItemTemplate="{StaticResource NavigationTemplate}" Style="{StaticResource AdminNavigationListStyle}"
                         ItemContainerStyle="{StaticResource AdminNavigationItemStyle}" Foreground="{StaticResource AdminShellTextBrush}"
                         AutomationProperties.Name="Modules autorises" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                <StackPanel Grid.Row="6">
                    <Border Padding="10" CornerRadius="12" Background="#12FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <TextBlock Text="{Binding ApiStatus}" Foreground="{StaticResource AdminShellTextBrush}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Environment}" Foreground="#BFD0C9" FontSize="9"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button Margin="0,8,0,0" Height="36" MinWidth="36" Padding="8,0" Content="Deconnexion"
                            Background="Transparent" BorderBrush="#30FFFFFF" Foreground="{StaticResource AdminShellTextBrush}"
                            Command="{Binding LogoutCommand}" AutomationProperties.Name="Se deconnecter">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers><DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True"><Setter Property="Content" Value="X"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="14,10,22,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Breadcrumb}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PageTitle}" Margin="0,3,0,0" Style="{StaticResource AdminTitleTextStyle}"/>
                    <TextBlock Text="{Binding PageSubtitle}" Margin="0,2,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="12,8" CornerRadius="13" Background="{StaticResource AccentAltSoftBrush}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding ApiStatus}" Margin="7,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/></StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="12,8" CornerRadius="14" Background="{StaticResource ElevatedSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="11" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="{Binding UserInitial}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding Role}" Margin="0,2,0,0" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Margin="14,6,22,6" Background="{StaticResource ContentSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="22" ClipToBounds="True">
                <ContentControl Content="{Binding CurrentModule}" AutomationProperties.Name="Contenu du module actif"/>
            </Border>

            <Grid Grid.Row="2" Margin="18,0,26,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Notice}" VerticalAlignment="Center" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="9" Foreground="{StaticResource MutedTextBrush}">
                    <Run Text="Client "/><Run Text="{Binding ClientVersion, Mode=OneWay}"/><Run Text="  |  API "/><Run Text="{Binding ApiVersion, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</Window>
