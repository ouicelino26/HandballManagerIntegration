<Window x:Class="HandballIntegration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Handball Integration"
        Width="1380"
        Height="880"
        MinWidth="1100"
        MinHeight="720">

    <Window.Resources>
        <Style x:Key="ShellNavigationListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="ShellNavigationItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#12FFFFFF"
                                BorderBrush="#20FFFFFF"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1BFFFFFF"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#34FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F5F1EA"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#F5F1EA"/>
                                <Setter Property="Foreground" Value="#192823"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="Foreground" Value="#FFF9F2"/>
        </Style>

        <Style x:Key="SidebarActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="Foreground" Value="#FFF9F2"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="320"
                     Height="320"
                     Fill="{StaticResource WarmGlowBrush}"
                     Canvas.Left="-80"
                     Canvas.Top="-90"/>
            <Ellipse Width="380"
                     Height="380"
                     Fill="#1EDCEFE9"
                     Canvas.Right="-90"
                     Canvas.Bottom="-110"/>
        </Canvas>

        <Grid Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="272"/>
                <ColumnDefinition x:Name="SidebarGapColumn" Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarBorder"
                    Grid.Column="0"
                    Background="{StaticResource ShellGradientBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="26"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="SidebarBrandTextPanel">
                            <Border Width="104"
                                    Padding="10,6"
                                    CornerRadius="12"
                                    Background="#18FFFFFF"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="Match ops"
                                           FontSize="11"
                                           Foreground="#F8F4EE"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Margin="0,14,0,0"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="#FFF9F2"
                                       Text="Handball Integration"/>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="#D9E8E2"
                                       Text="Navigation simple et controle rapide."/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                x:Name="SidebarToggleButton"
                                Style="{StaticResource SidebarToggleButtonStyle}"
                                Click="ToggleSidebar_Click">
                            <TextBlock x:Name="SidebarToggleGlyph"
                                       Text="&lt;"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1"
                            x:Name="SidebarStatusCard"
                            Margin="0,18,0,16"
                            Padding="14,12"
                            CornerRadius="18"
                            Background="#16FFFFFF"
                            BorderBrush="#24FFFFFF"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse Width="10"
                                     Height="10"
                                     VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FF9A8B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsApiConnected}" Value="True">
                                                <Setter Property="Fill" Value="#9DE0B2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <StackPanel x:Name="SidebarStatusTextPanel"
                                        Grid.Column="1"
                                        Margin="12,0,0,0">
                                <TextBlock Text="{Binding CurrentUsername, FallbackValue=Session}"
                                           FontSize="11"
                                           Foreground="#D9E8E2"/>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#FFF9F2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="En attente"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsApiConnected}" Value="True">
                                                    <Setter Property="Text" Value="API locale OK"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding CurrentRole, StringFormat=Role : {0}}"
                                           FontSize="11"
                                           Foreground="#D9E8E2"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ListBox x:Name="NavigationList"
                                 Style="{StaticResource ShellNavigationListStyle}"
                                 ItemContainerStyle="{StaticResource ShellNavigationItemStyle}"
                                 SelectionChanged="NavigationList_SelectionChanged">
                            <ListBoxItem Tag="dashboard" IsSelected="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40"
                                            Height="40"
                                            CornerRadius="12"
                                            Background="#24FFFFFF"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="01"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFF9F2"/>
                                    </Border>

                                    <StackPanel x:Name="DashboardNavTextPanel"
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Dashboard"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </ListBoxItem>

                            <ListBoxItem Tag="integration">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40"
                                            Height="40"
                                            CornerRadius="12"
                                            Background="#24FFFFFF"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="02"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFF9F2"/>
                                    </Border>

                                    <StackPanel x:Name="IntegrationNavTextPanel"
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Integration"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </ListBoxItem>

                            <ListBoxItem Tag="players">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40"
                                            Height="40"
                                            CornerRadius="12"
                                            Background="#24FFFFFF"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="03"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFF9F2"/>
                                    </Border>

                                    <StackPanel x:Name="PlayersNavTextPanel"
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Joueuses"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </ListBoxItem>

                            <ListBoxItem Tag="pdf">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40"
                                            Height="40"
                                            CornerRadius="12"
                                            Background="#24FFFFFF"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="04"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFF9F2"/>
                                    </Border>

                                    <StackPanel x:Name="PdfNavTextPanel"
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="PDF"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </ListBoxItem>

                            <ListBoxItem Tag="accounts">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40"
                                            Height="40"
                                            CornerRadius="12"
                                            Background="#24FFFFFF"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="05"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFF9F2"/>
                                    </Border>

                                    <StackPanel x:Name="AccountsNavTextPanel"
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Comptes"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </ListBoxItem>
                        </ListBox>
                    </ScrollViewer>

                    <Button Grid.Row="3"
                            x:Name="LogoutButton"
                            Margin="0,14,0,0"
                            Style="{StaticResource SidebarActionButtonStyle}"
                            Click="LogoutButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="10"
                                    Background="#24FFFFFF"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="X"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="#FFF9F2"/>
                            </Border>

                            <StackPanel x:Name="LogoutTextPanel"
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Se deconnecter"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource SurfaceCardStyle}"
                        Background="#FFF8F0"
                        Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="ShellSectionText"
                                       Style="{StaticResource EyebrowTextStyle}"
                                       Text="Vue rapide"/>
                            <TextBlock x:Name="ShellTitleText"
                                       Margin="0,6,0,0"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Dashboard"/>
                            <TextBlock x:Name="ShellSubtitleText"
                                       Margin="0,8,0,0"
                                       Style="{StaticResource BodyTextStyle}"
                                       Text="Les informations utiles, sans surcharge."/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Padding="14,10"
                                CornerRadius="16"
                                Background="{StaticResource SoftNeutralBrush}"
                                VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="API en attente"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsApiConnected}" Value="True">
                                                <Setter Property="Text" Value="API locale"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource SurfaceCardStyle}"
                        Padding="0"
                        Background="{StaticResource ContentSurfaceBrush}">
                    <Frame x:Name="ContentFrame"
                           NavigationUIVisibility="Hidden"
                           Background="Transparent"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
