<Window x:Class="HandballIntegration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:models="clr-namespace:HandballIntegration.Admin.Models"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="HandWStat Administration"
        Width="1440"
        Height="900"
        MinWidth="1060"
        MinHeight="700"
        Background="{StaticResource AppBackgroundBrush}">
    <Window.Resources>
        <DataTemplate x:Key="ExpandedNavigationTemplate" DataType="{x:Type models:AdminNavigationItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="10" Background="#18FFFFFF"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Glyph}" FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                    <TextBlock Text="{Binding Description}" Margin="0,2,0,0" FontSize="10"
                               Opacity="0.66" TextTrimming="CharacterEllipsis"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CollapsedNavigationTemplate" DataType="{x:Type models:AdminNavigationItem}">
            <Grid ToolTip="{Binding Label}">
                <TextBlock Text="{Binding Glyph}" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="292"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarBorder" Grid.Column="0" Margin="12" Padding="18"
                Background="{StaticResource AdminShellBrush}" CornerRadius="26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="HW" Foreground="White" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel x:Name="BrandTextPanel" Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ApplicationNameText" Foreground="{StaticResource AdminShellTextBrush}"
                                   FontFamily="{StaticResource AdminDisplayFont}" FontSize="17" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Plateforme d'administration" Margin="0,2,0,0" Foreground="#BFD0C9" FontSize="10"/>
                    </StackPanel>
                    <Button x:Name="SidebarToggleButton" Grid.Column="2" Width="36" Height="36" MinWidth="36"
                            Padding="0" Content="&lt;" Background="#18FFFFFF" BorderBrush="#30FFFFFF"
                            AutomationProperties.Name="Replier le menu"
                            Click="ToggleSidebar_Click"/>
                </Grid>

                <ListBox x:Name="NavigationList" Grid.Row="2"
                         Style="{StaticResource AdminNavigationListStyle}"
                         ItemContainerStyle="{StaticResource AdminNavigationItemStyle}"
                         ItemTemplate="{StaticResource ExpandedNavigationTemplate}"
                         Foreground="{StaticResource AdminShellTextBrush}"
                         AutomationProperties.Name="Modules d'administration"
                         SelectionChanged="NavigationList_SelectionChanged"/>

                <StackPanel Grid.Row="4">
                    <Border x:Name="SidebarApiCard" Padding="13,11" CornerRadius="14" Background="#12FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="SidebarApiDot" Width="9" Height="9" Fill="{StaticResource WarningBrush}"
                                     VerticalAlignment="Center"/>
                            <StackPanel x:Name="SidebarApiTextPanel" Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock x:Name="SidebarApiText" Foreground="{StaticResource AdminShellTextBrush}"
                                           FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SidebarEnvironmentText" Foreground="#BFD0C9" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button Margin="0,10,0,0" Height="38" MinWidth="38" Padding="10,0"
                            Background="Transparent" BorderBrush="#30FFFFFF"
                            AutomationProperties.Name="Se deconnecter"
                            Click="LogoutButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="x" Foreground="{StaticResource AdminShellTextBrush}" FontWeight="Bold"/>
                            <TextBlock x:Name="LogoutText" Text="Deconnexion" Margin="9,0,0,0"
                                       Foreground="{StaticResource AdminShellTextBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="18,12,26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ShellSectionText" Text="ADMINISTRATION" Foreground="{StaticResource AccentBrush}"
                               FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ShellTitleText" Text="Chargement" Margin="0,4,0,0"
                               Style="{StaticResource AdminTitleTextStyle}"/>
                    <TextBlock x:Name="ShellSubtitleText" Text="Validation des autorisations en cours."
                               Margin="0,3,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="15,10" CornerRadius="16" Background="{StaticResource ElevatedSurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="12" Background="{StaticResource AccentAltSoftBrush}">
                            <TextBlock x:Name="UserInitialText" Text="A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UsernameText" Text="Session" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock x:Name="RoleText" Text="Role en attente" Margin="0,2,0,0" FontSize="10"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Margin="18,8,26,8" Background="{StaticResource ContentSurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="24" ClipToBounds="True">
                <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" Background="Transparent"
                       AutomationProperties.Name="Contenu du module"/>
            </Border>

            <Grid Grid.Row="2" Margin="24,0,30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ShellNoticeText" VerticalAlignment="Center" FontSize="10"
                           Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ClientVersionText" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Text="  |  " FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="ApiVersionText" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
